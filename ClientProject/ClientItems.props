<Project>
  <PropertyGroup>
    <BuildTarget>Client</BuildTarget>
    <DefineConstants>$(DefineConstants);CLIENT</DefineConstants>
  </PropertyGroup>
  <Import Project="..\BuildData.props" />

  <ItemGroup>
    <ProjectReference Include="..\UiFramework\UiFramework.csproj"
                      AdditionalProperties="BuildTarget=Client;PlatformName=$(PlatformName);UsePublicizedAssemblies=$(UsePublicizedAssemblies)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ClientSource\UI\Markup\MainWindow.xml" LogicalName="SandboxMenu.MainWindow.xml" />
    <EmbeddedResource Include="ClientSource\UI\Markup\ContextMenu.xml" LogicalName="SandboxMenu.ContextMenu.xml" />
    <EmbeddedResource Include="ClientSource\UI\Markup\Browser.xml" LogicalName="SandboxMenu.Browser.xml" />
    <EmbeddedResource Include="ClientSource\UI\Markup\CharacterBrowser.xml" LogicalName="SandboxMenu.CharacterBrowser.xml" />
    <EmbeddedResource Include="ClientSource\UI\Markup\Options.xml" LogicalName="SandboxMenu.Options.xml" />
    <EmbeddedResource Include="ClientSource\UI\Markup\MultiPicker.xml" LogicalName="SandboxMenu.MultiPicker.xml" />
    <EmbeddedResource Include="ClientSource\UI\Markup\ColorPicker.xml" LogicalName="SandboxMenu.ColorPicker.xml" />
    <EmbeddedResource Include="ClientSource\UI\Markup\PresetEditor.xml" LogicalName="SandboxMenu.PresetEditor.xml" />
    <EmbeddedResource Include="ClientSource\UI\Markup\Styling\Theme.xml" LogicalName="SandboxMenu.Theme.xml" />
  </ItemGroup>
</Project>
