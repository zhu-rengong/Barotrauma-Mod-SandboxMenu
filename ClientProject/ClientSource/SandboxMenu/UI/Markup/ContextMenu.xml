<Stack Orientation="Vertical" Spacing="2">

  <Stack.Resources>
    <DataTemplate DataType="MenuOptionViewModel">
      <Row Text="{Binding Label}" Command="{Binding InvokeCommand}" Width="1" Height="0.14" />
    </DataTemplate>
  </Stack.Resources>

  <List Items="{Binding Options}" Height="1" Spacing="2" />

</Stack>
