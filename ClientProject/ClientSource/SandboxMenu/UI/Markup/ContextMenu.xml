<Window Width="288dip" Height="352dip">

<Stack Orientation="Vertical" Spacing="2">

  <Stack.Resources>
    <DataTemplate DataType="ContextOptionViewModel">
      <Row Text="{Binding Label}" Command="{Binding InvokeCommand}" Shortcut="{Binding Shortcut}" Width="1"
           Height="0.14" />
    </DataTemplate>
  </Stack.Resources>

  <List Items="{Binding Options}" Height="1" Spacing="2" />

</Stack>

</Window>
