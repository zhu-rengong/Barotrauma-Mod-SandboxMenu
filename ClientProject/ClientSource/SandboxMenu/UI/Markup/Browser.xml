<Stack Orientation="Vertical">

  <!-- The browser's rows are item rows: icon, name with the identifier after it, and the start of the
       description. The template is found by the row view model's type, and the list builds only the rows on
       screen, so the search text and the filters hand it the matching rows instead of hiding rows one by one.
       The tiles are the same view models as icons only: they fill the grid bands the list puts above and below
       its four detail rows, so the entries outside the scroll view stay in the same sequence and next to the
       rows they precede and follow. -->
  <Stack.Resources>
    <DataTemplate Key="ItemTile">
      <Tile Icon="{Binding Icon}" ToolTip="{Binding TileToolTip}" Command="{Binding PickCommand}" />
    </DataTemplate>

    <DataTemplate DataType="ItemRowViewModel">
      <Row Text="{Binding Title}" Icon="{Binding Icon}" SubText="{Binding SubText}" ToolTip="{Binding ToolTip}"
        Command="{Binding PickCommand}" Height="0.12" />
    </DataTemplate>
  </Stack.Resources>

  <Panel Skin="None" Height="16*">
    <Text Text="sandboxmenu.browser.title" Font="SubHeading" FontSize="22" Width="0.78" Height="1" Padding="8" />
    <Button Name="Close" Text="sandboxmenu.close" Shortcut="sandboxmenu.shortcut.close" Width="0.2" Height="0.6"
            Align="CenterRight" />
  </Panel>

  <TextBox Text="{Binding Query, Mode=TwoWay}" Height="10*" Clear="True" Focus="True" />

  <!-- What the list is limited to: the content packages and the item categories (several of either can be chosen
       at once — each button opens a list of tick boxes on top of this window and says what is ticked), and the
       rules of the parent container, which is a single tick box because there is only one of it. It only shows up
       when the browser was opened from an entry that is stored inside another item, and the two buttons then take
       the width it gives back. -->
  <Stack Orientation="Horizontal" Height="10*" ChildAnchor="CenterLeft">
    <Button Text="{Binding PackageFilter}" Command="{Binding PickPackagesCommand}" Width="2*" Height="0.8" Skin="GUITextBoxNoIcon" />
    <Button Text="{Binding CategoryFilter}" Command="{Binding PickCategoriesCommand}" Width="2*" Height="0.8" Skin="GUITextBoxNoIcon" />
    <Tick Text="{Binding ContainerFilterLabel}" Selected="{Binding ContainerOnly, Mode=TwoWay}" Width="1*"
      Visible="{Binding ContainerFilterVisible}" />
  </Stack>

  <List Name="Results" Items="{Binding Rows}" Height="64*" Spacing="3" Virtual="True"
        Rows="4" TileTemplate="ItemTile" />

</Stack>