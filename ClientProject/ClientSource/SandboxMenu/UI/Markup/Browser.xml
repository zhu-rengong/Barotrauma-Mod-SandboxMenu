<Window Width="880dip" Height="580dip">

<Stack Orientation="Vertical">

  <!-- The tiles are the same rows as icons only: they fill the grid bands above and below the detail rows, so the
       entries outside the scroll view keep their sequence. IconExtent is how much of its cell an icon takes, and the
       hover swell is a storyboard on Grow so the element itself carries no animation code. -->
  <Stack.Resources>
    <DataTemplate Key="ItemTile">
      <Tile Icon="{Binding Icon}" ToolTip="{Binding TileSelfToolTip}" Command="{Binding PickCommand}"
        SecondaryCommand="{Binding SelfCommand}" IconExtent="0.85">
        <Tile.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Trigger.EnterActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Property="Grow" To="1" Duration="0.12" Easing="QuadOut" />
                </Storyboard>
              </BeginStoryboard>
            </Trigger.EnterActions>
            <Trigger.ExitActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Property="Grow" To="0" Duration="0.12" Easing="QuadOut" />
                </Storyboard>
              </BeginStoryboard>
            </Trigger.ExitActions>
          </Trigger>

          <EventTrigger Event="SecondaryPressed">
            <EventTrigger.Actions>
              <BeginStoryboard>
                <Storyboard>
                  <ColorAnimationUsingKeyFrames Property="GlowFill" Duration="0.5" FillBehavior="Stop">
                    <EasingColorKeyFrame KeyTime="0" Value="Transparent" />
                    <EasingColorKeyFrame KeyTime="0.3" Value="Accent" Easing="SineOut" />
                    <EasingColorKeyFrame KeyTime="0.5" Value="Transparent" Easing="SineIn" />
                  </ColorAnimationUsingKeyFrames>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger.Actions>
          </EventTrigger>
        </Tile.Triggers>
      </Tile>
    </DataTemplate>

    <DataTemplate DataType="ItemRowViewModel">
      <Row Text="{Binding Title}" Icon="{Binding Icon}" SubText="{Binding SubText}" ToolTip="{Binding SelfToolTip}"
        Command="{Binding PickCommand}" SecondaryCommand="{Binding SelfCommand}" Height="0.12" IconSize="30" />
    </DataTemplate>
  </Stack.Resources>

  <!-- The title takes what the close button leaves; what the right button does is said in each entry's tooltip. -->
  <Stack Orientation="Horizontal" Height="10*" ChildAnchor="CenterLeft">
    <Text Text="sandboxmenu.browser.title" Font="SubHeading" FontSize="22" Width="1*" Height="1" Padding="8" />
    <Button Text="sandboxmenu.close" Shortcut="sandboxmenu.shortcut.close" CloseView="True" Width="0.2" Height="0.6" />
  </Stack>

  <!-- What the list is limited to. The two buttons each open a list of tick boxes on top of this window; the container
       tick is a single one and only shows up when the browser came from an entry stored inside another item. -->
  <Stack Orientation="Horizontal" Height="10*" ChildAnchor="CenterLeft">
    <Button Text="{Binding PackageFilter}" Command="{Binding PickPackagesCommand}" Width="2*" Height="0.8" Skin="GUITextBoxNoIcon" Scale="False" />
    <Button Text="{Binding CategoryFilter}" Command="{Binding PickCategoriesCommand}" Width="1.5*" Height="0.8" Skin="GUITextBoxNoIcon" Scale="False" />
    <TextBox Text="{Binding Query, Mode=TwoWay}" Width="1.5*" Height="0.8" Clear="True" Focus="True" />
    <Tick Text="{Binding ContainerFilterLabel}" Selected="{Binding ContainerOnly, Mode=TwoWay}" Width="1.5*"
      Visible="{Binding ContainerFilterVisible}" />
    <Tick Text="{Binding HiddenFilterLabel}" Selected="{Binding HideHidden, Mode=TwoWay}" Width="2*" />
  </Stack>

  <!-- The window's own skin is a top-dark gradient and a row highlight is a translucent white, so the list needs this
       frame under it or a hovered row reads as a gradient; the bands keep clear of its edges when a tile grows. -->
  <Panel Skin="InnerFrame" Height="80*">
    <List Items="{Binding Rows}" Scroll="{Binding Scroll, Mode=TwoWay}" Height="1" Spacing="3" Virtual="True" Rows="5"
          Padding="6,6" TileTemplate="ItemTile" />
  </Panel>

</Stack>

</Window>
