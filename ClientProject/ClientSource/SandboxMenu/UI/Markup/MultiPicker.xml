<Window Width="608dip" Height="528dip">

<Stack Orientation="Vertical">

  <!-- The search text hides rows instead of rebuilding them, so a row keeps its tick box and its tick; a row is one
       control of its own — tick box, icon and label — so the list sizes it to what it draws. -->
  <Stack.Resources>
    <DataTemplate DataType="ToggleRowViewModel">
      <Tick Selected="{Binding Selected, Mode=TwoWay}" Text="{Binding Label}" Icon="{Binding Icon}"
            Visible="{Binding Visible}" Width="1" Height="0.07" />
    </DataTemplate>
  </Stack.Resources>

  <Panel Skin="None" Height="16*">
    <Text Text="{Binding Title}" Font="SubHeading" FontSize="22" Width="0.78" Height="1" Padding="8" />
    <Button Text="sandboxmenu.close" Shortcut="sandboxmenu.shortcut.close" CloseView="True" Width="0.2" Height="0.6"
            Align="CenterRight" />
  </Panel>

  <!-- A filter, like the item browser: a package or a category can be looked up by typing. -->
  <TextBox Text="{Binding Query, Mode=TwoWay}" Height="12*" Clear="True" />

  <!-- Taking or clearing everything at once, outside the list so the pair stays reachable however far it is scrolled. -->
  <Stack Orientation="Horizontal" Height="8*" Spacing="3">
    <Button Text="selectall" Command="{Binding SelectAllCommand}" Width="1*" Height="1" />
    <Button Text="deselectall" Command="{Binding DeselectAllCommand}" Width="1*" Height="1" />
  </Stack>

  <List Items="{Binding Options}" Height="64*" Spacing="3" />

</Stack>

</Window>
