<Window ContentInset="16" Width="880dip" Height="580dip">

<Stack Orientation="Vertical">

  <Stack.Resources>
    <DataTemplate Key="ItemTile">
      <Tile Icon="{Binding Icon}" ToolTip="{Binding TileSelfToolTip}" Command="{Binding PickCommand}"
        SecondaryCommand="{Binding SelfCommand}" IconExtent="0.85">
        <Tile.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Trigger.EnterActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Property="Grow" To="1" Duration="0.12" Easing="QuadOut" />
                </Storyboard>
              </BeginStoryboard>
            </Trigger.EnterActions>
            <Trigger.ExitActions>
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Property="Grow" To="0" Duration="0.12" Easing="QuadOut" />
                </Storyboard>
              </BeginStoryboard>
            </Trigger.ExitActions>
          </Trigger>

          <EventTrigger Event="SecondaryPressed">
            <EventTrigger.Actions>
              <BeginStoryboard>
                <Storyboard>
                  <ColorAnimationUsingKeyFrames Property="GlowFill" Duration="0.35" FillBehavior="Stop">
                    <EasingColorKeyFrame KeyTime="0" Value="Accent" />
                    <EasingColorKeyFrame KeyTime="0.35" Value="Transparent" Easing="SineIn" />
                  </ColorAnimationUsingKeyFrames>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger.Actions>
          </EventTrigger>
        </Tile.Triggers>
      </Tile>
    </DataTemplate>

    <DataTemplate DataType="ItemRowViewModel">
      <Row Text="{Binding Title}" Icon="{Binding Icon}" SubText="{Binding SubText}" ToolTip="{Binding SelfToolTip}"
        Command="{Binding PickCommand}" SecondaryCommand="{Binding SelfCommand}" Height="0.12" IconSize="30" />
    </DataTemplate>
  </Stack.Resources>

  <Stack Orientation="Horizontal" Height="10*" ChildAnchor="CenterLeft">
    <Text Text="sandboxmenu.browser.title" Font="SubHeading" FontSize="22" Width="1*" Height="1" Padding="8" />
    <Button Text="sandboxmenu.close" Shortcut="sandboxmenu.shortcut.close" CloseView="True" Width="0.2" Height="0.6" />
  </Stack>

  <Panel Skin="InnerFrame" Width="1" Height="90*" Padding="17,19,20,16">
    <Stack Orientation="Vertical">

      <Stack Orientation="Horizontal" Height="10*" ChildAnchor="CenterLeft">
        <Button Text="{Binding PackageFilter}" Command="{Binding PickPackagesCommand}" Width="2*" Height="0.8" Skin="GUITextBoxNoIcon" Scale="False" />
        <Button Text="{Binding CategoryFilter}" Command="{Binding PickCategoriesCommand}" Width="1.5*" Height="0.8" Skin="GUITextBoxNoIcon" Scale="False" />
        <TextBox Text="{Binding Query, Mode=TwoWay}" Width="1.5*" Height="0.8" Clear="True" Focus="True" />
        <Tick Text="{Binding ContainerFilterLabel}" Selected="{Binding ContainerOnly, Mode=TwoWay}" Width="1.5*"
          Visible="{Binding ContainerFilterVisible}" />
        <Tick Text="{Binding HiddenFilterLabel}" Selected="{Binding HideHidden, Mode=TwoWay}" Width="2*" />
      </Stack>

      <List Items="{Binding Rows}" Scroll="{Binding Scroll, Mode=TwoWay}" Height="80*" Spacing="3" Virtual="True" Rows="5" Padding="8,0,0,8"
            TileTemplate="ItemTile" />
    </Stack>
  </Panel>

</Stack>

</Window>
