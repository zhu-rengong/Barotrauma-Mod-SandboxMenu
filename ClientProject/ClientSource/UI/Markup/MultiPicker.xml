<Window ContentInset="16" Width="608dip" Height="528dip">

<Stack Orientation="Vertical">

  <Stack.Resources>
    <DataTemplate DataType="ToggleRowViewModel">
      <Tick Selected="{Binding Selected, Mode=TwoWay}" Text="{Binding Label}" Icon="{Binding Icon}"
            Visible="{Binding Visible}" Width="1" Height="0.07" />
    </DataTemplate>
  </Stack.Resources>

  <Panel Skin="None" Height="16*">
    <Text Text="{Binding Title}" Font="SubHeading" FontSize="22" Width="0.78" Height="1" Padding="8" />
    <Button Text="sandboxmenu.close" Shortcut="sandboxmenu.shortcut.close" CloseView="True" Width="0.2" Height="0.6"
            Align="CenterRight" />
  </Panel>

  <Panel Skin="InnerFrame" Width="1" Height="84*" Padding="17,19,20,16">
    <Stack Orientation="Vertical" Spacing="6">

      <TextBox Text="{Binding Query, Mode=TwoWay}" Height="30dip" Clear="True" />

      <Stack Orientation="Horizontal" Height="37dip" Spacing="3">
        <Button Text="selectall" Command="{Binding SelectAllCommand}" Width="1*" Height="1" />
        <Button Text="deselectall" Command="{Binding DeselectAllCommand}" Width="1*" Height="1" />
      </Stack>

      <List Items="{Binding Options}" Height="1*" Spacing="3" />
    </Stack>
  </Panel>

</Stack>

</Window>
