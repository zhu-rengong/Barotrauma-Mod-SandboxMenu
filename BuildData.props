<Project>
  <PropertyGroup>
    <ModName>SandboxMenu</ModName>
    <!-- Used for the RepositoryUrl assembly metadata injected in SharedItems.props (plugin metadata). -->
    <RepositoryURL>https://github.com/zhu-rengong/Barotrauma-Mod-SandboxMenu</RepositoryURL>
    <UsePublicizedAssemblies>true</UsePublicizedAssemblies>
  </PropertyGroup>

  <Import Project="UserBuildData.props" />

  <Import Project="SharedProject\SharedProject.projitems" Label="Shared" />
  <Import Project="SharedProject\SharedItems.props" />
  <!-- The markup UI framework is a client concern; the server assembly must not carry it. -->
  <Import Project="UiFramework\UiFramework.projitems" Label="Shared" Condition="'$(BuildTarget)' != 'Server'" />

  <Target Name="CopyFiles" AfterTargets="Build">
    <ItemGroup>
      <FilesToCopy Include="$(TargetDir)$(TargetName).dll" />
      <FilesToCopy Include="$(TargetDir)$(TargetName).deps.json" />
      <FilesToCopy Include="$(TargetDir)$(TargetName).pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(MSBuildThisFileDirectory)ContentPackageBuilder\Content\bin\$(PlatformName)" />
  </Target>
</Project>
