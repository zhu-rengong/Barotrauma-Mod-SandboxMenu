<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>UiFramework</RootNamespace>
    <AssemblyName>UiFramework</AssemblyName>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Authors />
    <UsePublicizedAssemblies Condition="'$(UsePublicizedAssemblies)' == ''">true</UsePublicizedAssemblies>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <BuildTarget>Client</BuildTarget>
    <_UiPlatform>$(RuntimeIdentifier)</_UiPlatform>
    <_UiPlatform Condition="'$(_UiPlatform)' == 'win-x64'">Windows</_UiPlatform>
    <_UiPlatform Condition="'$(_UiPlatform)' == 'linux-x64'">Linux</_UiPlatform>
    <_UiPlatform Condition="'$(_UiPlatform)' == 'osx-x64'">Mac</_UiPlatform>
    <_UiPlatform Condition="'$(_UiPlatform)' == ''">Windows</_UiPlatform>
    <PlatformName Condition="'$(PlatformName)' == ''">$(_UiPlatform)</PlatformName>
  </PropertyGroup>

  <ItemGroup Condition="'$(UsePublicizedAssemblies)' != 'true'">
    <PackageReference Include="Barotrauma.ReferenceAssemblies.Vanilla" Version="*-*" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsePublicizedAssemblies)' == 'true'">
    <PackageReference Include="Barotrauma.ReferenceAssemblies.Vanilla.Publicized" Version="*-*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Collections.Immutable" Version="9.0.0" />
    <PackageReference Include="Barotrauma.ReferenceAssemblies.Libraries" Version="*-*" />
    <PackageReference Include="HarmonyX" Version="2.15.0" />
  </ItemGroup>
</Project>
